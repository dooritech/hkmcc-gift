                <p class="text-sm">등록된 교우 정보가 없거나 검색 조건과 일치하지 않습니다.</p>
            </div>
        </div>

    </main>

    <!-- Google Sheet Integration Modal -->
    <div id="googleSheetModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200">
        <div class="bg-white rounded-2xl max-w-2xl w-full mx-4 shadow-2xl border border-slate-200 overflow-hidden max-h-[90vh] flex flex-col">
            <div class="p-5 bg-catholic-900 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-file-csv text-amber-300 text-lg"></i>
                    <h3 class="font-bold text-md">구글 시트(Google Sheets) 연동 설정</h3>
                </div>
                <button onclick="closeModal('googleSheetModal')" class="text-slate-300 hover:text-white text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4 text-sm text-slate-600">
                <p class="leading-relaxed">
                    구글 드라이브의 Google Sheets와 연동하면 본 양식에서 제출된 데이터가 즉시 구글 시트에 행으로 자동 추가됩니다.
                </p>

                <!-- Steps -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs">
                    <h4 class="font-bold text-slate-800 text-sm">연동 방법 안내:</h4>
                    <ol class="list-decimal list-inside space-y-1.5 leading-relaxed text-slate-700">
                        <li>구글 시트를 생성하고 첫 행에 헤더를 작성합니다: <code class="bg-slate-200 px-1 rounded">PID, FID, Name, BaptismalName, Phone, Zone, SubZone, Address, City, Zipcode, Remarks, Date</code></li>
                        <li>상단 메뉴에서 <strong>확장 프로그램 &gt; Apps Script</strong>를 클릭합니다.</li>
                        <li>아래 코드 복사 후 붙여넣고 <strong>[배포] &gt; [새 배포]</strong>를 선택합니다.</li>
                        <li>유형: <strong>웹 앱</strong> / 액세스 권한: <strong>모든 사용자(Anyone)</strong>로 설정하여 배포 후 웹 앱 URL을 복사합니다.</li>
                    </ol>
                </div>

                <!-- Apps Script Code Snippet -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-bold text-slate-700">Google Apps Script 코드를 복사하세요:</span>
                        <button onclick="copyAppsScript()" class="text-xs text-catholic-700 hover:underline flex items-center space-x-1">
                            <i class="fa-regular fa-copy"></i>
                            <span>코드 복사</span>
                        </button>
                    </div>
                    <pre class="bg-slate-900 text-emerald-400 p-3 rounded-lg text-[11px] font-mono overflow-x-auto leading-tight" id="scriptCode">
function doPost(e) {
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var data = JSON.parse(e.postData.contents);
    
    sheet.appendRow([
      data.pid,
      data.fid,
      data.name,
      data.baptismalName,
      data.phone,
      data.zone,
      data.subZone,
      data.address,
      data.city,
      data.zipcode,
      data.remarks,
      new Date().toLocaleString('ko-KR')
    ]);
    
    return ContentService.createTextOutput(JSON.stringify({"result": "success"}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({"result": "error", "error": err.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}</pre>
                </div>

                <!-- Web App URL Input -->
                <div class="pt-2">
                    <label for="webAppUrl" class="block text-xs font-semibold text-slate-700 mb-1">배포된 Apps Script 웹 앱 URL</label>
                    <input type="url" id="webAppUrl" placeholder="https://script.google.com/macros/s/.../exec" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-catholic-500">
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end space-x-2">
                <button onclick="closeModal('googleSheetModal')" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-300 transition">
                    취소
                </button>
                <button onclick="saveGoogleSheetUrl()" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold transition">
                    저장 및 연동
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl z-50 flex items-center space-x-3 transform translate-y-20 opacity-0 transition-all duration-300">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMessage" class="text-sm font-medium">처리되었습니다.</span>
    </div>

    <!-- Application Script -->
    <script>
        // Sample Initial Data based on Parish Schema
        const sampleMembers = [
            {
                pid: "PID-2026001",
                fid: "FID-1001",
                name: "김철수",
                baptismalName: "요한",
                phone: "010-2345-6789",
                zone: "노스산호세",
                subZone: "1반",
                address: "100 North 1st St",
                city: "San Jose",
                zipcode: "95112",
                remarks: "구역장",
                createdAt: "2026-10-20"
            },
            {
                pid: "PID-2026002",
                fid: "FID-1001",
                name: "이영희",
                baptismalName: "마리아",
                phone: "010-8765-4321",
                zone: "노스산호세",
                subZone: "1반",
                address: "100 North 1st St",
                city: "San Jose",
                zipcode: "95112",
                remarks: "배우자",
                createdAt: "2026-10-20"
            },
            {
                pid: "PID-2026003",
                fid: "FID-1002",
                name: "박준형",
                baptismalName: "안드레아",
                phone: "010-3344-5566",
                zone: "팔로알토",
                subZone: "2반",
                address: "450 Serra Mall",
                city: "Stanford",
                zipcode: "94305",
                remarks: "일반교우",
                createdAt: "2026-10-21"
            },
            {
                pid: "PID-2026004",
                fid: "FID-1003",
                name: "최수지",
                baptismalName: "체칠리아",
                phone: "010-9988-7766",
                zone: "써니베일",
                subZone: "3반",
                address: "700 El Camino Real",
                city: "Sunnyvale",
                zipcode: "94087",
                remarks: "전입교우",
                createdAt: "2026-10-22"
            }
        ];

        let members = [];
        let googleSheetUrl = "";

        // Initialize Application State
        window.onload = function() {
            const storedMembers = localStorage.getItem('catholic_members');
            if (storedMembers) {
                members = JSON.parse(storedMembers);
            } else {
                members = [...sampleMembers];
                saveToLocalStorage();
            }

            googleSheetUrl = localStorage.getItem('catholic_sheets_url') || "";
            if (googleSheetUrl) {
                document.getElementById('webAppUrl').value = googleSheetUrl;
                updateSheetBadge(true);
            }

            renderTable();
            updateStats();
        };

        // Render Table Rows with Search & Filter
        function renderTable() {
            const tbody = document.getElementById('memberTableBody');
            const emptyState = document.getElementById('emptyState');
            const searchVal = document.getElementById('searchInput').value.toLowerCase().trim();
            const filterZone = document.getElementById('filterZone').value;

            tbody.innerHTML = '';

            const filteredMembers = members.filter(m => {
                const matchesSearch = m.name.toLowerCase().includes(searchVal) || 
                                      m.baptismalName.toLowerCase().includes(searchVal) ||
                                      m.phone.includes(searchVal) ||
                                      m.pid.toLowerCase().includes(searchVal) ||
                                      m.fid.toLowerCase().includes(searchVal);
                
                const matchesZone = filterZone === "" || m.zone === filterZone;

                return matchesSearch && matchesZone;
            });

            if (filteredMembers.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filteredMembers.forEach(m => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition text-slate-700 border-b border-slate-100";
                
                tr.innerHTML = `
                    <td class="py-3 px-4 font-mono text-xs text-catholic-800 font-semibold">${m.pid}</td>
                    <td class="py-3 px-4 font-mono text-xs text-amber-700 font-medium">${m.fid}</td>
                    <td class="py-3 px-4 font-medium text-slate-900">
                        ${m.name} <span class="text-xs text-slate-500 font-normal">(${m.baptismalName})</span>
                    </td>
                    <td class="py-3 px-4">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-catholic-50 text-catholic-800 border border-catholic-100">
                            ${m.zone} ${m.subZone ? m.subZone : ''}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-xs font-mono">${m.phone}</td>
                    <td class="py-3 px-4 text-xs max-w-xs truncate" title="${m.address}, ${m.city} ${m.zipcode}">
                        ${m.address}${m.city ? ', ' + m.city : ''}
                    </td>
                    <td class="py-3 px-4">
                        <span class="px-2 py-0.5 rounded text-[11px] font-medium ${getRemarkBadgeColor(m.remarks)}">
                            ${m.remarks || '일반'}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-right">
                        <button onclick="deleteMember('${m.pid}')" class="text-xs text-red-500 hover:text-red-700 p-1 transition" title="삭제">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Helper Badge Stylings
        function getRemarkBadgeColor(remark) {
            switch(remark) {
                case '구역장': return 'bg-amber-100 text-amber-800 border border-amber-200';
                case '반장': return 'bg-blue-100 text-blue-800 border border-blue-200';
                case '쉬는교우': return 'bg-slate-200 text-slate-700';
                case '전입교우': return 'bg-emerald-100 text-emerald-800 border border-emerald-200';
                default: return 'bg-slate-100 text-slate-600';
            }
        }

        // Handle Household Type Radio Toggle
        function toggleHouseholdInput() {
            const householdType = document.querySelector('input[name="householdType"]:checked').value;
            const container = document.getElementById('existingFidContainer');
            if (householdType === 'existing') {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        // Verify Existing FID
        function verifyFid() {
            const fidInput = document.getElementById('fidInput').value.trim();
            if (!fidInput) {
                showToast("세대 ID(FID)를 입력해 주세요.", "error");
                return;
            }
            const found = members.filter(m => m.fid.toUpperCase() === fidInput.toUpperCase());
            if (found.length > 0) {
                showToast(`확인됨: [${found[0].name}] 세대주의 가구입니다. (${found.length}명 등록됨)`, "success");
            } else {
                showToast("해당 FID로 등록된 세대를 찾을 수 없습니다.", "error");
            }
        }

        // Submit New Member Registration
        function handleFormSubmit(e) {
            e.preventDefault();

            const householdType = document.querySelector('input[name="householdType"]:checked').value;
            let fid = "";

            if (householdType === 'existing') {
                fid = document.getElementById('fidInput').value.trim();
                if (!fid) {
                    showToast("기존 세대 ID(FID)를 입력해주세요.", "error");
                    return;
                }
            } else {
                fid = generateFID();
            }

            const newMember = {
                pid: generatePID(),
                fid: fid,
                name: document.getElementById('memberName').value.trim(),
                baptismalName: document.getElementById('baptismalName').value.trim(),
                phone: document.getElementById('phone').value.trim(),
                zone: document.getElementById('zone').value,
                subZone: document.getElementById('subZone').value.trim(),
                address: document.getElementById('address').value.trim(),
                city: document.getElementById('city').value.trim(),
                zipcode: document.getElementById('zipcode').value.trim(),
                remarks: document.getElementById('remarks').value,
                createdAt: new Date().toISOString().split('T')[0]
            };

            members.unshift(newMember);
            saveToLocalStorage();
            renderTable();
            updateStats();

            // Sync to Google Sheets if WebApp URL exists
            if (googleSheetUrl) {
                sendToGoogleSheet(newMember);
            }

            showToast(`${newMember.name} (${newMember.baptismalName}) 교우님이 성공적으로 등록되었습니다.`, "success");
            clearForm();
        }

        // Generate Unique Identifiers
        function generatePID() {
            const nextNum = members.length + 1001;
            return `PID-2026${nextNum}`;
        }

        function generateFID() {
            const existingFids = members.map(m => parseInt(m.fid.replace('FID-', ''))).filter(n => !isNaN(n));
            const maxFid = existingFids.length > 0 ? Math.max(...existingFids) : 1000;
            return `FID-${maxFid + 1}`;
        }

        // Clear Form Fields
        function clearForm() {
            document.getElementById('registrationForm').reset();
            document.querySelector('input[name="householdType"][value="new"]').checked = true;
            toggleHouseholdInput();
        }

        // Delete Member Entry
        function deleteMember(pid) {
            if (confirm("정말로 이 교우 정보를 삭제하시겠습니까?")) {
                members = members.filter(m => m.pid !== pid);
                saveToLocalStorage();
                renderTable();
                updateStats();
                showToast("삭제 완료되었습니다.", "success");
            }
        }

        // Save LocalStorage
        function saveToLocalStorage() {
            localStorage.setItem('catholic_members', JSON.stringify(members));
        }

        // Reset to Default Sample Data
        function resetToSampleData() {
            if (confirm("샘플 데이터로 초기화하시겠습니까? 기존 등록 데이터가 대체됩니다.")) {
                members = [...sampleMembers];
                saveToLocalStorage();
                renderTable();
                updateStats();
                showToast("샘플 데이터로 초기화되었습니다.", "success");
            }
        }

        // Update Dashboard Analytics
        function updateStats() {
            document.getElementById('statTotalMembers').innerText = members.length;
            const uniqueHouseholds = new Set(members.map(m => m.fid)).size;
            document.getElementById('statTotalHouseholds').innerText = uniqueHouseholds;
        }

        // Send Data to Google Sheet Apps Script
        function sendToGoogleSheet(memberData) {
            fetch(googleSheetUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(memberData)
            })
            .then(() => {
                showToast("구글 시트 전송 요청이 완료되었습니다.", "success");
            })
            .catch(err => {
                console.error(err);
                showToast("구글 시트 전송 실패. URL을 확인하세요.", "error");
            });
        }

        // Save Google Sheets Web App URL
        function saveGoogleSheetUrl() {
            const url = document.getElementById('webAppUrl').value.trim();
            googleSheetUrl = url;
            localStorage.setItem('catholic_sheets_url', url);
            updateSheetBadge(!!url);
            closeModal('googleSheetModal');
            showToast(url ? "구글 시트 URL이 설정되었습니다." : "구글 시트 연동이 해제되었습니다.", "success");
        }

        function updateSheetBadge(isConnected) {
            const badge = document.getElementById('sheetStatusBadge');
            if (isConnected) {
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200";
                badge.innerText = "구글 시트 연동 중";
            } else {
                badge.className = "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600";
                badge.innerText = "미연동 (로컬 저장)";
            }
        }

        // Export Data to CSV
        function exportToCSV() {
            if (members.length === 0) {
                showToast("내보낼 데이터가 없습니다.", "error");
                return;
            }

            const headers = ["PID", "FID", "Name", "BaptismalName", "Phone", "Zone", "SubZone", "Address", "City", "Zipcode", "Remarks", "CreatedAt"];
            const rows = members.map(m => [
                m.pid, m.fid, m.name, m.baptismalName, m.phone, m.zone, m.subZone, `"${m.address}"`, m.city, m.zipcode, m.remarks, m.createdAt
            ]);

            let csvContent = "\uFEFF" + headers.join(",") + "\n" + rows.map(e => e.join(",")).join("\n");
            
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `성당_교적명단_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Copy Code Snippet Helper
        function copyAppsScript() {
            const code = document.getElementById('scriptCode').innerText;
            const tempElem = document.createElement('textarea');
            tempElem.value = code;
            document.body.appendChild(tempElem);
            tempElem.select();
            document.execCommand('copy');
            document.body.removeChild(tempElem);
            showToast("Apps Script 코드가 클립보드에 복사되었습니다.", "success");
        }

        // Modal Helpers
        function openModal(id) {
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Toast Notification Helper
        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMessage.innerText = message;
            if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-exclamation text-red-400";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
